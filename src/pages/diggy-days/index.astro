---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const appStore = 'https://apps.apple.com/app/diggy-days-treasure-digger/id6802410647';

const title = 'Diggy Days: Treasure Digger — DUX Games';
const description = 'Dig into history. Blast through ancient ground, unearth relics and treasure, master your tools and explore lost lands. A pixel-art treasure-digging game for iOS — free to play.';
const canonical = 'https://mrsanchezzzzz.github.io/dux-games/diggy-days/';
const ogImage = `${import.meta.env.SITE}${base}assets/diggy-days-banner.webp`;

const shots = [
  { src: `${base}assets/promo-screens/diggy-days/1.webp`, alt: 'Digging up an Ancient Key in Diggy Days' },
  { src: `${base}assets/promo-screens/diggy-days/2.webp`, alt: 'Discoveries collection of hidden treasures' },
  { src: `${base}assets/promo-screens/diggy-days/3.webp`, alt: 'Restoring the Warlord’s Gauntlet relic' },
  { src: `${base}assets/promo-screens/diggy-days/4.webp`, alt: 'Upgrading tools — trowel, shovel, pickaxe, backpack' },
  { src: `${base}assets/promo-screens/diggy-days/5.webp`, alt: 'Region Mastery across ancient lands' },
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  "name": "Diggy Days: Treasure Digger",
  "description": "A pixel-art treasure-digging game. Blast through ancient ground, unearth relics and treasure, upgrade your tools, and explore lost lands.",
  "applicationCategory": "GameApplication",
  "operatingSystem": "iOS",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "screenshot": shots.map(s => `${import.meta.env.SITE}${s.src}`),
  "image": ogImage,
  "url": canonical,
  "publisher": { "@type": "Organization", "name": "DUX Games" }
});
---
<BaseLayout {title} {description} {canonical} {ogImage} {jsonLd}>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container dd-hero">
      <div class="dd-hero-copy">
        <img class="dd-icon" src={`${base}assets/diggy-days-icon.webp`} alt="Diggy Days app icon" width="120" height="120" />
        <span class="kicker"><span class="eyebrow-dot"></span>Casual · Digging · iOS</span>
        <h1>Dig into <em>history.</em></h1>
        <p class="lede">Uncover the past, become legend. Blast through ancient ground, haul up relics and buried treasure, upgrade your gear and explore lost lands — one swing of the pickaxe at a time.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={appStore} target="_blank" rel="noopener">Download on iOS <span class="arrow">↗</span></a>
          <a class="btn btn-ghost" href="#screens">See screenshots</a>
        </div>
      </div>
      <div class="dd-hero-media">
        <video
          class="dd-video"
          autoplay
          muted
          loop
          playsinline
          disablepictureinpicture
          preload="auto"
          poster={`${base}assets/promo-screens/diggy-days/1.webp`}
          tabindex="-1"
          aria-label="Diggy Days gameplay"
        >
          <source src={`${base}assets/diggy-days/gameplay.mp4`} type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <!-- ============ SCREENSHOTS ============ -->
  <section class="dd-section" id="screens">
    <div class="container">
      <div class="section-head divider">
        <h2>From the dig site</h2>
        <span class="idx">(screens)</span>
      </div>
      <div class="dd-shots">
        {shots.map(s => (
          <div class="dd-shot"><img src={s.src} alt={s.alt} loading="lazy" width="414" height="896" /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FEATURES ============ -->
  <section class="dd-section">
    <div class="container">
      <div class="section-head divider">
        <h2>What's in the mine</h2>
        <span class="idx">(features)</span>
      </div>
      <div class="dd-grid">
        <div class="dd-card">
          <div class="dd-emoji">💎</div>
          <h3>Discover hidden treasures</h3>
          <p>Dig through dirt, stone and bedrock to reveal coins, artefacts and rare finds. Fill your Discoveries log — every layer hides something new.</p>
        </div>
        <div class="dd-card">
          <div class="dd-emoji">🏺</div>
          <h3>Collect ancient relics</h3>
          <p>Piece together legendary relics like the Warlord's Gauntlet, each with its own story, and restore history one artefact at a time.</p>
        </div>
        <div class="dd-card">
          <div class="dd-emoji">⛏️</div>
          <h3>Master your tools</h3>
          <p>Trowel, shovel, pickaxe, bigger backpack — repair, level up and stack upgrades to break through what stopped you last time.</p>
        </div>
        <div class="dd-card">
          <div class="dd-emoji">🗺️</div>
          <h3>Explore ancient lands</h3>
          <p>From Lost Ruins to old battlefields to Space itself — master each region to boost its rare finds and gold for good.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DOWNLOAD ============ -->
  <section class="dd-section divider">
    <div class="container dd-download">
      <h2>Ready to dig<span class="dot">?</span></h2>
      <p>Diggy Days: Treasure Digger is out now on the App Store. Free to play on iPhone.</p>
      <a class="btn btn-primary" href={appStore} target="_blank" rel="noopener">Get it on the App Store <span class="arrow">↗</span></a>
      <a class="dd-privacy mono" href={`${base}diggy-days/privacy-policy/`}>Privacy policy</a>
    </div>
  </section>

</BaseLayout>

<style>
  .dd-section { border-bottom: 1px solid var(--line); }

  /* ---- Hero: copy left, video right ---- */
  .dd-hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 56px;
    padding: 88px 0 96px;
  }
  .dd-hero-copy { text-align: left; }
  .dd-hero-copy .kicker { display: block; margin-bottom: 20px; }
  .dd-hero-copy h1 { text-align: left; max-width: 14ch; }
  .dd-hero-copy .lede { margin: 26px 0 0; text-align: left; }
  .dd-hero-copy .hero-cta { justify-content: flex-start; margin-top: 36px; }

  .dd-icon {
    width: 96px;
    height: 96px;
    border-radius: 22px;
    margin-bottom: 26px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.55);
    border: 1px solid var(--line-2);
  }

  .dd-hero-media { display: flex; justify-content: center; }

  /* ---- Screenshots ---- */
  .dd-shots {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin-bottom: 80px;
  }
  .dd-shot {
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-2);
    transition: transform .25s ease, border-color .25s ease;
  }
  .dd-shot:hover { transform: translateY(-4px); border-color: var(--green); }
  .dd-shot img { width: 100%; height: auto; display: block; }

  /* ---- Features ---- */
  .dd-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 80px;
  }
  .dd-card {
    background: var(--bg);
    padding: 40px 30px 44px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: background .2s ease;
  }
  .dd-card:hover { background: var(--bg-2); }
  .dd-emoji { font-size: 30px; line-height: 1; }
  .dd-card h3 {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.01em;
    margin: 4px 0 0;
  }
  .dd-card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }

  /* ---- Hero video ---- */
  .dd-video {
    width: 100%;
    max-width: 340px;
    aspect-ratio: 592 / 1280;
    border-radius: 22px;
    border: 1px solid var(--line-2);
    background: #000;
    box-shadow: 0 30px 70px rgba(0,0,0,0.6);
  }

  /* ---- Download ---- */
  .dd-download {
    text-align: center;
    padding-top: 88px;
    padding-bottom: 96px;
  }
  .dd-download h2 {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .dd-download h2 .dot { color: var(--green); }
  .dd-download p {
    font-size: 18px;
    color: var(--muted);
    max-width: 460px;
    margin: 22px auto 34px;
  }
  .dd-download .dd-privacy {
    display: block;
    font-size: 11px;
    color: var(--muted-2);
    margin-top: 26px;
    transition: color .15s ease;
  }
  .dd-download .dd-privacy:hover { color: var(--green); }

  @media (max-width: 860px) {
    .dd-hero {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
      padding: 64px 0 72px;
    }
    .dd-hero-copy { text-align: center; }
    .dd-hero-copy h1 { max-width: none; }
    .dd-hero-copy .kicker,
    .dd-hero-copy h1,
    .dd-hero-copy .lede { text-align: center; }
    .dd-hero-copy .lede { margin-left: auto; margin-right: auto; max-width: 560px; }
    .dd-hero-copy .hero-cta { justify-content: center; }
    .dd-icon { margin-left: auto; margin-right: auto; }
    .dd-hero-media { order: -1; }
  }

  @media (max-width: 980px) {
    .dd-shots { grid-template-columns: repeat(3, 1fr); }
    .dd-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .dd-shots { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .dd-grid { grid-template-columns: 1fr; }
  }
</style>
